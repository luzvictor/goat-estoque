generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusPedido {
  Pendente
  Enviado
  Concluido
  Cancelado
}


model ProdutoBase {
  id_produto_base String @id @default(cuid())
  nome            String

  categoriaId     String
  categoria       Categoria @relation(fields: [categoriaId], references: [id])

  marcaId         String
  marca           Marca     @relation(fields: [marcaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variantes VarianteProduto[]
}

model VarianteProduto {
  id_variante String @id @default(cuid())

  corId           String
  cor             Cor       @relation(fields: [corId], references: [id])

  tamanhoId       String?   
  tamanho         Tamanho?  @relation(fields: [tamanhoId], references: [id])

  valorCusto Float
  valorVenda Float
  estoqueMin Int
  quantidade Int
  sku        String? @unique 
  imageUrl   String?

  produtoBaseId String
  produtoBase   ProdutoBase @relation(fields: [produtoBaseId], references: [id_produto_base], onDelete: Cascade)

  entradas EntradaEstoque[]
  pedidos  PedidoProduto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([produtoBaseId, corId, tamanhoId])
}

model Categoria {
  id    String @id @default(cuid())
  nome  String @unique

  produtos ProdutoBase[] 
}

model Marca {
  id    String @id @default(cuid())
  nome  String @unique

  produtos ProdutoBase[] 
}

model Cor {
  id    String @id @default(cuid())
  nome  String @unique 

  variantes VarianteProduto[] 
}

model Tamanho {
  id    String @id @default(cuid())
  nome  String @unique 

  variantes VarianteProduto[] // Relação inversa
}


model EntradaEstoque {
  id_entrada String   @id @default(cuid())
  data       DateTime
  quantidade Int
  numeroNota String?

  varianteId String
  variante   VarianteProduto @relation(fields: [varianteId], references: [id_variante], onDelete: Restrict)

  @@unique([numeroNota, varianteId], name: "entrada_unica_por_nota_e_variante")
}

model Pedido {
  id        String          @id @default(uuid())
  data      DateTime        @default(now())
  status    StatusPedido    @default(Pendente)
  produtos  PedidoProduto[] 

  clienteId String? 
 Cliente   Cliente? @relation(fields: [clienteId], references: [id_cliente], onDelete: SetNull)

  criadoPorUsuarioId String?
  CriadoPor Usuario? @relation(name: "PedidosCriados", fields: [criadoPorUsuarioId], references: [id_usuario], onDelete: SetNull)
}

model PedidoProduto {
  id       String @id @default(uuid())
  pedidoId String
  pedido  Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  varianteId String
  variante   VarianteProduto @relation(fields: [varianteId], references: [id_variante], onDelete: Restrict)

  quantidade Int
}


model Cliente {
  id_cliente String  @id @default(cuid())
  nome       String
  cpf        String? @unique // Opcional, mas único se preenchido
  endereco   String?
  telefone   String?

  pedidos Pedido[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
enum Role {
  ADM
  USUARIO
}

model Usuario {
  id_usuario String @id @default(cuid())
  nome       String
  email      String @unique
  senha      String

  role       Role    @default(USUARIO)
  pedidosCriados Pedido[] @relation(name: "PedidosCriados")
  notificacoes NotificacaoUsuario[] 
}

model Notificacao {
  id_notificacao String   @id @default(cuid())
  mensagem       String
  link           String?
  dataEnvio      DateTime @default(now())

  usuarios NotificacaoUsuario[] 
}

model NotificacaoUsuario {
  id          String    @id @default(cuid())
  lida        Boolean   @default(false) 
  dataLeitura DateTime?

  usuarioId     String
  notificacaoId String

  usuario     Usuario     @relation(fields: [usuarioId], references: [id_usuario])
  notificacao Notificacao @relation(fields: [notificacaoId], references: [id_notificacao])

  @@unique([usuarioId, notificacaoId])
}
