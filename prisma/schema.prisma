generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusPedido {
  Pendente
  Enviado
  Concluido // Nomes de enum não podem ter acentos
  Cancelado
}


model ProdutoBase {
  id_produto_base String @id @default(cuid())
  nome            String

  categoriaId     String
  categoria       Categoria @relation(fields: [categoriaId], references: [id])

  marcaId         String
  marca           Marca     @relation(fields: [marcaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variantes VarianteProduto[] // Relacionamento com as variantes
}

model VarianteProduto {
  id_variante String @id @default(cuid())

  corId           String
  cor             Cor       @relation(fields: [corId], references: [id])

  tamanhoId       String?   // Opcional, como antes
  tamanho         Tamanho?  @relation(fields: [tamanhoId], references: [id])

  // Campos específicos da variante
  valorCusto Float
  valorVenda Float
  estoqueMin Int
  quantidade Int // Estoque atual desta variante específica
  sku        String? @unique // SKU único para a variante (recomendado)
  imageUrl   String? // URL da imagem específica da variante (se houver)

  // Relacionamento com ProdutoBase
  produtoBaseId String
  produtoBase   ProdutoBase @relation(fields: [produtoBaseId], references: [id_produto_base], onDelete: Cascade)

  // Relacionamentos com Estoque e Pedidos
  entradas EntradaEstoque[]
  pedidos  PedidoProduto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Garante que cor/tamanho sejam únicos para um mesmo produto base
  @@unique([produtoBaseId, corId, tamanhoId])
}

model Categoria {
  id    String @id @default(cuid())
  nome  String @unique // O @unique impede nomes duplicados como "Adidas" e "Addias"

  produtos ProdutoBase[] // Relação inversa
}

model Marca {
  id    String @id @default(cuid())
  nome  String @unique

  produtos ProdutoBase[] // Relação inversa
}

model Cor {
  id    String @id @default(cuid())
  nome  String @unique // Ex: "Azul Marinho", "Preto", "Branco"

  variantes VarianteProduto[] // Relação inversa
}

model Tamanho {
  id    String @id @default(cuid())
  nome  String @unique // Ex: "P", "M", "G", "38", "40"

  variantes VarianteProduto[] // Relação inversa
}


model EntradaEstoque {
  id_entrada String   @id @default(cuid())
  data       DateTime @default(now())
  quantidade Int
  numeroNota String?

  varianteId String
  variante   VarianteProduto @relation(fields: [varianteId], references: [id_variante], onDelete: Restrict)
}

model Pedido {
  id        String          @id @default(uuid())
  data      DateTime        @default(now())
  status    StatusPedido    @default(Pendente)
  produtos  PedidoProduto[] // Relacionamento com PedidoProduto

  clienteId String? // Pode ser uma venda sem cliente cadastrado
 Cliente   Cliente? @relation(fields: [clienteId], references: [id_cliente], onDelete: SetNull)

  // Relacionamento com o Usuario (quem criou o pedido no sistema)
  criadoPorUsuarioId String?
  CriadoPor Usuario? @relation(name: "PedidosCriados", fields: [criadoPorUsuarioId], references: [id_usuario], onDelete: SetNull)
}

model PedidoProduto {
  id       String @id @default(uuid())
  pedidoId String
  pedido  Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  varianteId String
  variante   VarianteProduto @relation(fields: [varianteId], references: [id_variante], onDelete: Restrict)

  quantidade Int
}

// Em: prisma/schema.prisma

model Cliente {
  id_cliente String  @id @default(cuid())
  nome       String
  cpf        String? @unique // Opcional, mas único se preenchido
  endereco   String?
  telefone   String?

  // Relacionamento: Um cliente pode ter vários pedidos
  pedidos Pedido[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Usuario {
  id_usuario String @id @default(cuid())
  nome       String
  email      String @unique
  senha      String

  pedidosCriados Pedido[] @relation(name: "PedidosCriados")

  notificacoes NotificacaoUsuario[] // Relacionamento com NotificacaoUsuario
}

model Notificacao {
  id_notificacao String   @id @default(cuid())
  mensagem       String
  link           String?
  dataEnvio      DateTime @default(now())

  usuarios NotificacaoUsuario[] // Relacionamento com NotificacaoUsuario
}

model NotificacaoUsuario {
  id          String    @id @default(cuid())
  lida        Boolean   @default(false) // Se esta instância da notificação foi lida por este usuário
  dataLeitura DateTime?

  usuarioId     String
  notificacaoId String

  usuario     Usuario     @relation(fields: [usuarioId], references: [id_usuario])
  notificacao Notificacao @relation(fields: [notificacaoId], references: [id_notificacao])

  @@unique([usuarioId, notificacaoId])
}
